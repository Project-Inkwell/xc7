(DELAYFILE
    (SDFVERSION "3.0")
    (TIMESCALE 1ns)
    (CELL
        (CELLTYPE "OBUFT")
        (INSTANCE IOB33/OUTBUF)
        (DELAY
            (ABSOLUTE
                (IOPATH IN OUT (1.166::1.353)(2.492::2.649))
                (IOPATH TRI OUT (0.823::0.951)(2.053::2.664))
            )
        )
    )
    (CELL
        (CELLTYPE "IOB33")
        (INSTANCE IOB33)
        (DELAY
            (ABSOLUTE
                (PORT OUTBUF/IN (0.037::0.115)(0.417::0.417))
                (INTERCONNECT OUTBUF/OUT INBUF_EN/PAD (0.000::0.000)(0.000::0.000))
                (DEVICE INBUF_EN/OUT (0.000::0.002)(0.002::0.006))
            )
        )
    )
)

    (TIMESCALE 1ns)
    (CELL
        (CELLTYPE "BUFGCTRL")
        (INSTANCE BUFGCTRL/BUFGCTRL)
        (DELAY
            (ABSOLUTE
                (IOPATH (negedge I0) O (0.026::0.029)(0.077::0.081))
                (IOPATH (posedge I0) O (0.026::0.029)(0.077::0.081))
                (IOPATH (negedge I1) O (0.026::0.029)(0.077::0.081))
                (IOPATH (posedge I1) O (0.026::0.029)(0.077::0.081))
            )
        )
        (TIMINGCHECK

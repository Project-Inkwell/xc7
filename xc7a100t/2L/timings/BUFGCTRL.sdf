                (PORT BUFGCTRL/CE0 (0.016::0.020)(0.055::0.062))
                (PORT BUFGCTRL/I0 (0.562::0.607)(1.500::1.574))
                (DEVICE BUFGCTRL/O (0.512::0.775)(1.210::1.308))
